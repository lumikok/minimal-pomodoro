{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "极简番茄钟",
  "version": "0.1.1",
  "identifier": "com.lumikok.minimal-pomodoro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "极简番茄钟",
      "width": 360,
      "height": 460,
      "minWidth": 340,
      "minHeight": 420,
      "resizable": true,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "离线学习番茄钟",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
